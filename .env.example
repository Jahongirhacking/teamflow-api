# Development muhiti. Nusxa oling: cp .env.example .env
NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=5434
DB_USER=teamflow
DB_PASSWORD=teamflow_local_pw
DB_NAME=teamflow_dev

JWT_SECRET=change-me-dev-secret-at-least-32-chars-long
JWT_EXPIRES_IN=15m

# Shu email bilan ro'yxatdan o'tgan foydalanuvchi global ADMIN bo'ladi
ADMIN_EMAIL=admin@teamflow.local

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=5242880
