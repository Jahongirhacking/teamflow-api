# Test muhiti. Nusxa oling: cp .env.test.example .env.test
# (.env.test bo'lmasa, testlar shu faylning o'zidan foydalanadi.)
#
# XAVFSIZLIK: DB_NAME albatta "_test" bilan tugashi shart.
# Aks holda test infratuzilmasi ishga tushishni rad etadi va hech narsa o'chirmaydi.
NODE_ENV=test
PORT=0

DB_HOST=127.0.0.1
DB_PORT=5434
DB_USER=teamflow
DB_PASSWORD=teamflow_local_pw
DB_NAME=teamflow_test

JWT_SECRET=test-only-secret-do-not-use-anywhere-else-0123456789
JWT_EXPIRES_IN=15m

ADMIN_EMAIL=admin@teamflow.test

# Testlar bu qiymatni o'zi vaqtinchalik papkaga almashtiradi (os.tmpdir()).
UPLOAD_DIR=./.test-storage
MAX_UPLOAD_SIZE_BYTES=5242880
